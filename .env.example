# Copia este archivo como .env y ajusta si lo necesitas.
# Si no defines DATABASE_URL, se usa SQLite en data/noc_syslog.db
# Ejemplo futuro (nube): DATABASE_URL=postgresql://usuario:clave@host:5432/noc
# (NUNCA pongas la URL real con clave en el código ni en GitHub)
APP_ENV=desarrollo
# --- Notificaciones (Fase 8). Los valores reales van SOLO en .env ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
# Filtros anti-saturación (opcionales)
NOTIF_SEV_TELEGRAM=2
NOTIF_SEV_CORREO=3
NOTIF_SEV_WHATSAPP=1
NOTIF_MAX_HORA_TELEGRAM=10
NOTIF_MAX_HORA_CORREO=6
NOTIF_MAX_HORA_WHATSAPP=3
NOTIF_SILENCIO_MIN=30