# Copia este archivo como .env y ajusta si lo necesitas.
# Si no defines DATABASE_URL, se usa SQLite en data/noc_syslog.db
# Ejemplo futuro (nube): DATABASE_URL=postgresql://usuario:clave@host:5432/noc
# (NUNCA pongas la URL real con clave en el código ni en GitHub)
APP_ENV=desarrollo
# --- Notificaciones (Fase 8). Los valores reales van SOLO en .env ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
# Filtros anti-saturación (opcionales)
NOTIF_SEV_TELEGRAM=2
NOTIF_SEV_CORREO=3
NOTIF_SEV_WHATSAPP=1
NOTIF_MAX_HORA_TELEGRAM=10
NOTIF_MAX_HORA_CORREO=6
NOTIF_MAX_HORA_WHATSAPP=3
NOTIF_SILENCIO_MIN=30

# --- v1.1.0: vigilancia de equipos caídos (opcional) ---
# Consola: segundos de silencio antes del "latido" (Enter) y latidos sin respuesta para declararlo caído
NOC_LATIDO_SEG=20
NOC_LATIDO_FALLOS=2
# Ping a los equipos REALES con IP (true/false), cada cuántos segundos y fallos seguidos
NOC_MONITOREO_PING=false
NOC_PING_SEG=60
NOC_PING_FALLOS=3

# --- Agente auditor (Fase 12) con Hermes Agent (Nous Research) — motor principal ---
# Hermes corre en este PC con su API Server (hermes gateway). La clave es la misma
# API_SERVER_KEY del archivo .env de Hermes. Valores reales SOLO en .env, nunca en GitHub.
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODELO=hermes-agent

# --- Alternativas si no hay Hermes (opcional: sin nada, el informe se hace por reglas) ---
# Use UNA de las dos claves (los valores reales van SOLO en .env, nunca en GitHub):
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Modelo opcional (si se deja vacío: claude-haiku-5-5 o gemini-2.5-flash)
IA_MODELO=
